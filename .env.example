# AirWise India Environment Configuration Template
# Copy this file to .env and configure your local settings

# Backend Configuration
AIRWISE_ENV=production_prototype
HOST=127.0.0.1
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Central Pollution Control Board (CPCB) API Adapter (Optional)
# If CPCB or state SPCB direct CAAQMS API keys are provided, configure here:
CPCB_API_KEY=
CPCB_API_URL=https://airquality.cpcb.gov.in/aqi_all_india/

# India Meteorological Department (IMD) / Open-Meteo Integration
IMD_API_KEY=
METEO_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Machine Learning Engine
MODEL_PATH=./app/models/aqi_forecast_model.joblib
METRICS_PATH=./app/models/model_evaluation_metrics.json
DEMONSTRATION_MODE=false

# Frontend Configuration
VITE_API_BASE=http://127.0.0.1:8000/api
VITE_APP_TITLE=AirWise India
